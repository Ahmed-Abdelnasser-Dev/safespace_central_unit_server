# Safe Space Central Unit - Environment Configuration

# Server Configuration
PORT=5000
HOST=0.0.0.0
NODE_ENV=development
FRONTEND_URL=http://localhost:4000
ALLOWED_ORIGINS=http://localhost:4000,http://192.168.10.25:4000

# Database (PostgreSQL + Prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/safespace_central_unit_node_test?schema=public

# Node Authentication (Add API keys for each Raspberry Pi Node)
# Example: NODE_101_KEY=your-secure-key-here
NODE_101_KEY=test-key-node-101-development
NODE_102_KEY=test-key-node-102-development

# Logging
LOG_LEVEL=info
MOBILE_APP_SERVER_URL=http://localhost:3103

# MOBILE_APP_SERVER_URL can point to your real URL in deployment environments.

# Base URL to resolve relative media URLs sent by Mobile Server (e.g. /uploads/...) 
# Set to the Mobile App Server address so relative paths can be downloaded.
MOBILE_SERVER_BASE_URL=http://localhost:3103

# These are already the defaults in your code, but you can set them:
MOBILE_APP_PROXY_HEADER_NAME=X-Forwarded-Client-Cert
MOBILE_APP_PROXY_HEADER_VALUE=central-unit

MOBILE_APP_CLIENT_CERT_HEADER_NAME=X-Client-Cert-Verified
MOBILE_APP_CLIENT_CERT_HEADER_VALUE=true
MOBILE_SERVER_SHARED_SECRET=

# Security hardening toggles (set to true after clients send required headers)
ENFORCE_NODE_API_KEY=false
ENFORCE_MOBILE_SERVER_AUTH=false

# JWT Secret for signing tokens (use a secure, random string in production)
JWT_SECRET=dev-jwt-secret-change-me-1234
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-1234