# Safe Space Backend Environment Template

# Runtime
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# CORS / Frontend origins
FRONTEND_URL=http://localhost:4000
ALLOWED_ORIGINS=http://localhost:4000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/safespace_central_unit_node_test?schema=public

# Authentication
JWT_SECRET=replace-with-strong-secret-at-least-16-chars
JWT_REFRESH_SECRET=replace-with-strong-refresh-secret-at-least-16-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=10
MAX_LOGIN_ATTEMPTS=5
PASSWORD_HISTORY_LIMIT=5

# Node and mobile integration
NODE_101_KEY=replace-node-101-key
NODE_102_KEY=replace-node-102-key
MOBILE_APP_SERVER_URL=http://localhost:3103
MOBILE_SERVER_BASE_URL=http://localhost:3103
MOBILE_APP_PROXY_HEADER_NAME=X-Forwarded-Client-Cert
MOBILE_APP_PROXY_HEADER_VALUE=central-unit
MOBILE_APP_CLIENT_CERT_HEADER_NAME=X-Client-Cert-Verified
MOBILE_APP_CLIENT_CERT_HEADER_VALUE=true
MOBILE_SERVER_SHARED_SECRET=
ENFORCE_NODE_API_KEY=false
ENFORCE_MOBILE_SERVER_AUTH=false

# Logging
LOG_LEVEL=info
