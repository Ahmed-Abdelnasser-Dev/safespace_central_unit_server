{
  "name": "safe-space-backend",
  "version": "1.0.0",
  "description": "Safe Space Central Unit Backend Server",
  "main": "server.js",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "test:accident": "node tests/accident-detection.script.js",
    "test:heartbeat": "node tests/heartbeat-video.script.js",
    "test:blocked-lanes": "bash tests/blocked-lanes.sh",
    "test:geospatial": "node tests/geospatial-normalization.script.js",
    "db:push": "npx prisma db push",
    "db:seed": "node prisma/seed.js",
    "db:reset": "npx prisma db push --force-reset && node prisma/seed.js",
    "db:studio": "npx prisma studio",
    "prisma:generate": "npx prisma generate"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "keywords": [
    "express",
    "backend",
    "mqtt",
    "geospatial"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "@turf/turf": "^6.5.0",
    "axios": "^1.6.2",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "mqtt": "^5.3.3",
    "multer": "^2.0.2",
    "pg": "^8.18.0",
    "prisma": "^7.7.0",
    "socket.io": "^4.6.1",
    "uuid": "^13.0.0",
    "winston": "^3.11.0",
    "ws": "^8.19.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@jest/globals": "^30.3.0",
    "form-data": "^4.0.5",
    "jest": "^30.3.0",
    "nodemon": "^3.0.2",
    "supertest": "^7.2.2"
  }
}
